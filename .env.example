# ─────────────────────────────────────────────────────────────
#  MailFlow — server/.env.example
#  Copy this file to server/.env and fill in your real values.
#  NEVER commit server/.env to version control.
# ─────────────────────────────────────────────────────────────

# ── Node environment ──────────────────────────────────────────
NODE_ENV=development

# ── Server port ───────────────────────────────────────────────
PORT=5000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/mailflow?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=8h

# ── Admin account (seeded via npm run seed) ───────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ── SendGrid (Phase 2 — leave blank for dry-run mode) ────────
SENDGRID_API_KEY=SG.REPLACE_WITH_YOUR_SENDGRID_API_KEY
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=MailFlow

# ── Rate limiting ─────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Campaign limits ───────────────────────────────────────────
MAX_RECIPIENTS_PER_CAMPAIGN=500

# ── Frontend Demo Mode (Vite) ──────────────────────────────────
# Disabled by default in production.
# SECURITY NOTICE: All VITE_* variables are baked into the frontend JavaScript
# bundle and are publicly visible to any browser user.
# NEVER place real production admin credentials in VITE_DEMO_* variables.
# Only configure a dedicated, restricted evaluation account.
# The Quick Login button is only shown when VITE_ENABLE_DEMO_LOGIN=true AND
# both VITE_DEMO_EMAIL and VITE_DEMO_PASSWORD are non-empty.
# VITE_ENABLE_DEMO_LOGIN=false
# VITE_DEMO_EMAIL=demo-evaluator@example.com
# VITE_DEMO_PASSWORD=DemoSecretPass123!
